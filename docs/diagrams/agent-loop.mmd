flowchart TB
    START((Input)) --> CTX["Context management"]
    CTX --> PRE["Pre-sampling Hook"]
    PRE --> LLM["LLM streaming output"]
    LLM --> TC{tool_use?}

    TC --> |Yes| PERM{Permission needed?}
    PERM --> |Yes| USER["👤 User approval"]
    USER --> |allow| TOOL_PRE
    USER --> |deny| DENIED["Denied"]
    PERM --> |No| TOOL_PRE["Pre-tool Hook"]
    TOOL_PRE --> EXEC["Run tools concurrently"]
    EXEC --> TOOL_POST["Post-tool Hook"]
    TOOL_POST --> CTX
    DENIED --> CTX

    TC --> |No| POST["Post-sampling Hook"]
    POST --> STOP{"Stop Hook"}
    STOP --> |Fail| CTX
    STOP --> |Pass| BUDGET{"Token Budget"}
    BUDGET --> |Continue| CTX
    BUDGET --> |Done| DONE((Done))

    subgraph SUB["Sub-agent"]
        FORK["AgentTool"] --> RECURSE["Recursive call"]
    end

    EXEC -.-> FORK

    classDef proc fill:#eef,stroke:#66c,color:#224
    classDef decision fill:#fee,stroke:#c66,color:#422
    classDef hook fill:#ffe,stroke:#cc6,color:#442
    classDef io fill:#eff,stroke:#6cc,color:#244
    classDef sub fill:#efe,stroke:#6a6,color:#242

    class CTX,LLM,EXEC proc
    class TC,PERM,STOP,BUDGET decision
    class PRE,TOOL_PRE,TOOL_POST,POST hook
    class START,DONE,USER,DENIED io
    class FORK,RECURSE sub
